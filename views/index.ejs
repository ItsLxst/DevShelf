<%- include('partials/header') %>

<main class="main-container">
    <section class="hero">
        <div class="badge">
            <span class="badge-label">STRIPE SANDBOX DEMO</span>
            <span class="badge-text">&middot; Test card: 4242 4242 4242 4242</span>
        </div>
        
        <h1 class="hero-title">
            Resources built for <br>
            <span class="highlight">working developers.</span>
        </h1>
        
        <p class="hero-subtitle">
            E-books and code templates to accelerate your career. Instant download after checkout.
        </p>
    </section>

    <section class="products-grid">
        <!-- cards inserted from databse-->
        <% products.forEach(product => { %>
        <div class="product-card" data-category="<%= product.category %>">
            <div class="card-header">
                <div class="card-icon"><%= product.icon %></div>
                <div class="card-badges">
                    
                    <% if (product.badge_text) { %>
                        <span class="badge-<%= product.badge_type %>"><%= product.badge_text %></span>
                    <% } %>
                    
                    <span class="badge-type"><%= product.category === 'ebook' ? 'E-Book' : 'Template' %></span>
                </div>
            </div>
            <h2 class="card-title"><%= product.title %></h2>
            <p class="card-desc"><%= product.description %></p>
            <span class="card-meta"><%= product.meta_text %></span>
            <div class="card-footer">
                <span class="card-price">$<%= parseInt(product.price) %></span>
                <button class="add-to-cart">Add to cart</button>
            </div>
        </div>
        <% }) %>
    </section>

    <!-- cart overlay -->
    <div class="cart-overlay"></div>
    
    <aside class="cart-drawer">
        <div class="cart-header">
            <h2 class="cart-title">Cart (0)</h2>
            <button class="close-cart">&times;</button>
        </div>
        
        <div class="cart-body">
            <!-- empty cart -->
            <div class="empty-cart">
                <div class="empty-icon">🛒</div>
                <p>Your cart is empty</p>
            </div>

            <!-- cart with items -->
            <div class="cart-items hidden">
                <div class="cart-item">
                    <div class="item-icon">📘</div>
                    <div class="item-details">
                        <h4>Node.js API Masterclass</h4>
                        <p>E-Book</p>
                    </div>
                    <div class="item-actions">
                        <span class="item-price">$29</span>
                        <button class="remove-item">Remove</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="cart-footer hidden">
            <div class="cart-total">
                <span>Total</span>
                <span class="total-price">$0</span>
            </div>
            <button class="checkout-btn">
                <img src="/images/card.svg" alt="Card Icon" width="18" height="18">
                Continue to Payment
            </button>
            <p class="secure-badge">Secured by Stripe &middot; Sandbox mode</p>
        </div>
    </aside>
</main>

<%- include('partials/footer') %>