<%- include('partials/header') %>

<main class="main-container">
    <section class="hero">
        <div class="badge">
            <span class="badge-label">STRIPE SANDBOX DEMO</span>
            <span class="badge-text">&middot; Test card: 4242 4242 4242 4242</span>
        </div>
        
        <h1 class="hero-title">
            Resources built for <br>
            <span class="highlight">working developers.</span>
        </h1>
        
        <p class="hero-subtitle">
            E-books and code templates to accelerate your career. Instant download after checkout.
        </p>
    </section>

    <section class="products-grid">
        <!-- 1st card -->
        <div class="product-card" data-category="ebook">
            <div class="card-header">
                <div class="card-icon">📘</div>
                <div class="card-badges">
                    <span class="badge-bestseller">Bestseller</span>
                    <span class="badge-type">E-Book</span>
                </div>
            </div>
            <h2 class="card-title">Node.js API Masterclass</h2>
            <p class="card-desc">REST & GraphQL APIs with Express, JWT auth, PostgreSQL, and deployment.</p>
            <span class="card-meta">210 pages</span>
            <div class="card-footer">
                <span class="card-price">$29</span>
                <button class="add-to-cart">Add to cart</button>
            </div>
        </div>

        <!-- 2nd card -->
        <div class="product-card" data-category="template">
            <div class="card-header">
                <div class="card-icon">⚡</div>
                <div class="card-badges">
                    <span class="badge-new">New</span>
                    <span class="badge-type">Template</span>
                </div>
            </div>
            <h2 class="card-title">SaaS Starter Kit</h2>
            <p class="card-desc">Full-stack Next.js boilerplate with auth, billing, dashboard, and dark mode.</p>
            <span class="card-meta">Next.js &middot; Stripe &middot; Prisma</span>
            <div class="card-footer">
                <span class="card-price">$49</span>
                <button class="add-to-cart">Add to cart</button>
            </div>
        </div>

        <!-- 3rd card -->
        <div class="product-card" data-category="ebook">
            <div class="card-header">
                <div class="card-icon">📘</div>
                <div class="card-badges">
                    <span class="badge-type">E-Book</span>
                </div>
            </div>
            <h2 class="card-title">System Design for Juniors</h2>
            <p class="card-desc">Cache, queues, load balancers — explained for entry-level engineers.</p>
            <span class="card-meta">145 pages</span>
            <div class="card-footer">
                <span class="card-price">$19</span>
                <button class="add-to-cart">Add to cart</button>
            </div>
        </div>

        <!-- 4th card -->
        <div class="product-card" data-category="template">
            <div class="card-header">
                <div class="card-icon">⚡</div>
                <div class="card-badges">
                    <span class="badge-type">Template</span>
                </div>
            </div>
            <h2 class="card-title">React Component Library</h2>
            <p class="card-desc">Production-ready UI components with Storybook, tests, and Tailwind.</p>
            <span class="card-meta">React &middot; TypeScript &middot; Tailwind</span>
            <div class="card-footer">
                <span class="card-price">$39</span>
                <button class="add-to-cart">Add to cart</button>
            </div>
        </div>

        <!-- 5th card -->
        <div class="product-card" data-category="ebook">
            <div class="card-header">
                <div class="card-icon">📘</div>
                <div class="card-badges">
                    <span class="badge-popular">Popular</span>
                    <span class="badge-type">E-Book</span>
                </div>
            </div>
            <h2 class="card-title">Remote Job Resume Pack</h2>
            <p class="card-desc">ATS-optimized resume templates, cover letter, and LinkedIn tips for devs.</p>
            <span class="card-meta">80 pages</span>
            <div class="card-footer">
                <span class="card-price">$15</span>
                <button class="add-to-cart">Add to cart</button>
            </div>
        </div>

        <!-- 6th card -->
        <div class="product-card" data-category="template">
            <div class="card-header">
                <div class="card-icon">⚡</div>
                <div class="card-badges">
                    <span class="badge-type">Template</span>
                </div>
            </div>
            <h2 class="card-title">Admin Dashboard Template</h2>
            <p class="card-desc">Clean analytics dashboard with charts, data tables, and mobile sidebar.</p>
            <span class="card-meta">React &middot; Recharts &middot; TailwindCSS</span>
            <div class="card-footer">
                <span class="card-price">$45</span>
                <button class="add-to-cart">Add to cart</button>
            </div>
        </div>
    </section>
</main>

<%- include('partials/footer') %>